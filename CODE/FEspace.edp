// ================================================================================
// ================================================================================
// ================================================================================
// FE-SPACE
// ================================================================================
// Original FEspace which is updated at every by the adaptmesh
// also by the propagation of the physical crack for hPF

// Type of element
func Pk = P1;

fespace Vh(Th, [Pk,Pk]);
Vh [u1, u2]=[0,0];
Vh [v1, v2];

fespace Vh2(Th, [Pk,Pk]);

fespace Vh4(Th, [Pk,Pk,Pk,Pk]);

fespace Xh(Th, Pk);
Xh d=0, v;
Xh H=0, Hold=0;
Xh eps11, eps12, eps22;
Xh sigma11, sigma12, sigma22;
Xh e11, e12, e22, trepsn, En;
Xh fhv; // fatigue history variable
Xh alphaold=0; // old Fatigue variable
Xh fhvold=0;  // Old cumulated variable
Xh fdf=1.0; // failure degradation function

Xh fhvnminus2, fhvnminus1, fhvn;

// Define the mask field on your current mesh space
Xh mask, vMask;
